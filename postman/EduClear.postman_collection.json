{
  "info": {
    "name": "EduClear API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Public API of EduClear, the independent college advisory platform. Every college figure links to an official source; payments run only in the PayPal sandbox."
  },
  "item": [
    {
      "name": "Colleges and audit trail",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health"
              ]
            },
            "description": "Service health and number of verified colleges loaded."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('has colleges', () => pm.expect(pm.response.json().colleges).to.be.above(0));"
                ]
              }
            }
          ]
        },
        {
          "name": "List colleges",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/colleges",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "colleges"
              ]
            },
            "description": "Verified colleges sorted by NIRF rank, each with a link to its official NIRF filing."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const rows = pm.response.json();",
                  "pm.test('every row links to an official filing', () => pm.expect(rows.every(r => r.source_url.startsWith('http'))).to.be.true);",
                  "pm.collectionVariables.set('collegeId', rows[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "College record",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/colleges/{{collegeId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "colleges",
                "{{collegeId}}"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('verified', () => pm.expect(pm.response.json().sources.verificationStatus).to.eql('Audited & Verified'));"
                ]
              }
            }
          ]
        },
        {
          "name": "College source evidence",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/colleges/{{collegeId}}/sources",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "colleges",
                "{{collegeId}}",
                "sources"
              ]
            },
            "description": "Field-by-field evidence: official URL, table/page locator and SHA-256 of the saved snapshot."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('provenance + hashes', () => { const j = pm.response.json(); pm.expect(Object.keys(j.provenance).length).to.be.above(5); pm.expect(Object.keys(j.snapshots_sha256).length).to.be.above(0); });"
                ]
              }
            }
          ]
        }
      ]
