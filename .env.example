# Copy to .env and fill in. NEVER commit .env. Sandbox values only.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_COUNSELLOR_PAYOUT_EMAIL=        # sandbox Personal account email used as counsellor
INR_TO_USD_RATE=0.0120                  # fixed, documented rate (decision D-08)

CHANNEL3_API_KEY=

LLM_PROVIDER=openrouter                 # openrouter | together | dashscope | hf | ollama
LLM_API_KEY=
LLM_MODEL=                              # exact Qwen3-4B slug for the chosen provider
OLLAMA_BASE_URL=http://localhost:11434

BRYNTUM_NPM_USER=
BRYNTUM_NPM_PASSWORD=
BRYNTUM_LICENSE_KEY=

DATABASE_URL=sqlite:///./educlear.db

# Stretch
ELASTIC_URL=
ELASTIC_API_KEY=
ZAPIER_WEBHOOK_URL=
POSTMAN_API_KEY=

# Accounts (PLAN_AUTH.md). Guests keep working while GUEST_CHECKOUT=true; set it to false once accounts are the only way to pay.
ENV=development                         # production: no demo code, a real mailer is required (none exists yet, so sign-in answers 503)
AUTH_SECRET=                            # long random string that keys the code hashes; required in production
GUEST_CHECKOUT=true
AUTH_SHOW_CODE=false                    # demo only: returns the sign-in code in the response (ignored when ENV=production)

PAYPAL_MCP_ENABLED=true   # set false to make the agent create orders through the REST API instead of the PayPal MCP server
