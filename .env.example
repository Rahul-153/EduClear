# Copy to .env and fill in. NEVER commit .env. Sandbox values only.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_COUNSELLOR_PAYOUT_EMAIL=        # sandbox Personal account email used as counsellor
INR_TO_USD_RATE=0.0120                  # fixed, documented rate (decision D-08)

CHANNEL3_API_KEY=

LLM_PROVIDER=openrouter                 # openrouter | together | dashscope | hf | opencode | ollama
LLM_API_KEY=
LLM_MODEL=                              # exact model slug for the chosen provider; empty with LLM_PROVIDER=opencode means deepseek-v4.1-flash-free
# OpenCode free model: LLM_PROVIDER=opencode, LLM_API_KEY=<key from opencode.ai/console>, LLM_MODEL=deepseek-v4.1-flash-free
# OpenRouter free model: LLM_PROVIDER=openrouter, LLM_API_KEY=<key from openrouter.ai/keys, starts with sk-or->, LLM_MODEL=google/gemma-4-31b-it:free
# Check it with: .venv/bin/python scripts/llm_smoke.py
LLM_LOCAL_FALLBACK=true                 # if the hosted model fails or is rate-limited, use local Ollama when it is running
OLLAMA_BASE_URL=http://localhost:11434

BRYNTUM_NPM_USER=
BRYNTUM_NPM_PASSWORD=
BRYNTUM_LICENSE_KEY=

DATABASE_URL=sqlite:///./educlear.db

# Stretch
ELASTIC_URL=
ELASTIC_API_KEY=
ZAPIER_WEBHOOK_URL=
POSTMAN_API_KEY=

PAYPAL_MCP_ENABLED=true   # set false to make the agent create orders through the REST API instead of the PayPal MCP server
